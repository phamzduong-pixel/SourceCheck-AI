# ==========================================
# SourceCheck AI - Environment Configuration
# ==========================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_secret_key_in_production

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Service
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Database Configuration (PostgreSQL)
POSTGRES_USER=sourcecheck
POSTGRES_PASSWORD=sourcecheck_password
POSTGRES_DB=sourcecheck_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://sourcecheck:sourcecheck_password@localhost:5432/sourcecheck_db

# Cache / Task Queue (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Vector Database (PostgreSQL + pgvector)
VECTOR_DB_TYPE=pgvector
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# LLM Providers (Placeholders)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4o-mini

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
